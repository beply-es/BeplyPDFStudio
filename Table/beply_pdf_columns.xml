<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : beply_pdf_columns.xml
    Author     : Beply Technologies S.L.
    Description: Columnas de la tabla de líneas de un estilo PDF (editor tipo editlist).
-->
<table>
    <column><name>id</name><type>serial</type><null>NO</null></column>
    <column><name>idstyle</name><type>integer</type><null>NO</null></column>
    <column><name>fieldname</name><type>character varying(30)</type><null>NO</null><default>'descripcion'</default></column>
    <column><name>align</name><type>character varying(10)</type><default>'left'</default></column>
    <column><name>coltype</name><type>character varying(20)</type><default>'text'</default></column>
    <column><name>width</name><type>integer</type><default>0</default></column>
    <column><name>orden</name><type>integer</type><default>100</default></column>
    <constraint>
        <name>ca_beply_pdf_columns_style</name>
        <type>FOREIGN KEY (idstyle) REFERENCES beply_pdf_styles (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>

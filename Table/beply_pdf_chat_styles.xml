<?xml version="1.0" encoding="UTF-8"?>
<!--
    Estilos de PDF Studio por tipo de documento del chat («contrato», «propuesta»…):
    cambios (colores, fuente, tamaños, logo) sobre el estilo de la empresa.
    nick NULL = estilo de la empresa (idempresa) o global (idempresa NULL);
    nick = estilo personal. Lib/ChatDocument/DocumentStyle valida `overrides`.
-->
<table>
    <column><name>id</name><type>serial</type><null>NO</null></column>
    <column><name>nick</name><type>character varying(50)</type></column>
    <column><name>idempresa</name><type>integer</type></column>
    <column><name>doc_type</name><type>character varying(40)</type><null>NO</null></column>
    <column><name>label</name><type>character varying(80)</type><null>NO</null></column>
    <column><name>overrides</name><type>text</type><null>NO</null></column>
    <column><name>creation_date</name><type>timestamp</type><null>NO</null></column>
    <column><name>last_update</name><type>timestamp</type></column>
    <constraint><name>beply_pdf_chat_styles_pkey</name><type>PRIMARY KEY (id)</type></constraint>
    <constraint><name>ca_beply_pdf_chat_styles_nick</name><type>FOREIGN KEY (nick) REFERENCES users (nick) ON DELETE CASCADE ON UPDATE CASCADE</type></constraint>
</table>

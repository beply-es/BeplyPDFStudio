{# Slot contract: slots.FISCAL_FOOTER is rendered through _fiscal-landscape-columns-close.html.twig. #}
<!DOCTYPE html>
<html lang="{{ html_lang|default('es') }}">
<head>
<meta charset="UTF-8">
<style>
  /* Fuentes cargadas por fichero (file://) — el plugin no depende de fuentes instaladas. */
  {{ font_faces|raw }}
  /* ===================== REGLAS GENERALES (robustez SIEMPRE) ===================== */
  @page {
    size: {{ page_size }};
    /* En páginas 2+ el margen superior = marginTop configurado + banda para la sub-cabecera,
       de modo que el CONTENIDO siga respetando el marginTop configurado (la banda es extra). */
    margin: {{ page_mt + 13 }}mm {{ page_mr }}mm {{ page_mb }}mm {{ page_ml }}mm;
    {% if page_footer_content %}
    @{{ page_footer_box }} {
      content: {{ page_footer_content|raw }};
      font-family: '{{ font_family }}', Arial, sans-serif;
      font-size: {{ page_footer_size }}px;
      color: {{ faint_color }};
    }
    {% endif %}
    /* Sub-cabecera de continuación (solo páginas 2+, se suprime en :first), a todo el ancho */
    @top-left {
      content: element(contInfo);
      vertical-align: bottom;
      width: 100%;
    }
  }
  @page :first {
    /* La 1ª página NO lleva sub-cabecera: margen superior configurado tal cual */
    margin-top: {{ page_mt }}mm;
    @top-left { content: none; }
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: '{{ font_family }}', 'Helvetica Neue', Arial, sans-serif;
    color: {{ text_color }};
    font-size: {{ font_size }}px;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; }

  /* Maqueta con TABLAS (no flex): ancho 100% garantizado y render consistente */
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { vertical-align: top; overflow-wrap: break-word; word-break: break-word; }
  thead { display: table-header-group; }   /* la cabecera de tabla se repite al paginar */
  tr { break-inside: avoid; }               /* las filas no se parten entre páginas */
  .l-header, .l-title, .l-client, .l-tax { break-inside: avoid; }

  /* Área de líneas: alto mínimo para que los totales caigan SIEMPRE al fondo de la página. */
  .lines-area { min-height: {{ lines_fill }}px; }
  /* Sub-cabecera de continuación (running element en el margen superior, solo páginas 2+) */
  .cont-info { position: running(contInfo); display: block; width: 100%; font-size: {{ font_size - 1 }}px; color: {{ muted_color }}; border-bottom: 1.5px solid {{ color1 }}; padding-bottom: 5px; margin-bottom: {{ page_mt }}mm; }
  .cont-info b { color: {{ color1 }}; font-weight: 800; }
  /* Totales + extras fluyen tras las líneas; las piezas internas evitan partirse. */
  .bottom { {% if bottom_anchor_transform %}transform: translateY({{ bottom_anchor_gap }}px); transform-origin: top left;{% else %}padding-top: {{ bottom_anchor_gap }}px;{% endif %} }

  /* ===================== BLOQUE FISCAL: documento + emisor ===================== */
  .doc-title {
    display: inline-block;
    font-size: {{ title_font_size }}px;
    font-weight: 800;
    color: {{ color1 }};
    border-bottom: 2px solid {{ color1 }};
    padding-bottom: 3px;
    margin-bottom: {{ (font_size * 1.2)|round }}px;
  }
  .company-fiscal-block { width: 100%; }

  /* ===================== CABECERA: bloque fiscal y logo desde la misma altura ===================== */
  .l-header { margin-bottom: {{ (font_size * 0.8)|round }}px; }
  .company-name { font-weight: 800; font-size: {{ font_size }}px; letter-spacing: .3px; margin-bottom: 3px; text-transform: uppercase; }
  .company-info { font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }
  .company-contact { font-size: {{ font_size }}px; color: {{ muted_color }}; margin-top: {{ (font_size * 0.8)|round }}px; line-height: 1.3; }
  .logo-cell { text-align: right; vertical-align: top; }
  .logo-cell img { width: {{ logo_size }}px; max-width: 100%; height: auto; }
  .logo-text { font-weight: 800; font-size: {{ font_size + 18 }}px; letter-spacing: -1px; }

  /* ===================== LÍNEA HORIZONTAL ROJA ===================== */
  .h-rule { border: none; border-top: 1px solid {{ color1 }}; margin: {{ (font_size * 0.8)|round }}px 0; }
  .l-client-rule { margin: {{ (font_size * 0.4)|round }}px 0; }

  /* ===================== BANDA CLIENTE + META ===================== */
  .l-client { margin: 0; }
  .l-client td { vertical-align: top; padding: {{ (font_size * 0.35)|round }}px 0; }
  .client-label { font-weight: 800; font-size: {{ font_size }}px; margin-bottom: 4px; color: {{ text_color }}; }
  .client-info { font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }
  .client-inner td { padding: 0; vertical-align: top; }
  /* Meta: dos columnas pegadas a la derecha (etiqueta izq · valor der) */
  .meta-table { margin-left: auto; width: auto; table-layout: auto; }
  .meta-table td { font-size: {{ font_size }}px; padding: 2px 0; }
  .meta-table .ml { text-align: left; white-space: nowrap; padding-right: 18px; color: {{ text_color }}; }
  .meta-table .ml b { font-weight: 800; }
  .meta-table .mr { text-align: right; white-space: nowrap; color: {{ muted_color }}; }
  .party-extra-inline { padding-left: {{ (font_size * 1.5)|round }}px; font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }
  .party-extra-inline .beply-slot-title { font-weight: 800; font-size: {{ font_size }}px; margin-bottom: 4px; color: {{ text_color }}; }
  .party-extra-inline .beply-slot-body { font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }

  /* ===================== TABLA DE LÍNEAS =====================
     auto-layout + cabecera en una sola línea (nowrap); la descripción ocupa el resto y ajusta. */
  .desc-table { table-layout: fixed; margin-top: {{ (font_size * 1.2)|round }}px; }
  .desc-table th, .desc-table td { white-space: nowrap; }
  .desc-table th:first-child, .desc-table td:first-child { white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
  .desc-table thead th { background: {{ color1 }}; color: {{ color2 }}; font-weight: 800; font-size: {{ font_size }}px; padding: 9px 12px; text-transform: uppercase; }
  .desc-table tbody td { font-size: {{ font_size }}px; padding: 9px 12px; color: {{ muted_color }}; }
  /* Bandeado de filas: línea sí, línea no (color terciario en las pares) */
  .desc-table tbody tr:nth-child(even) td { background: {{ color3 }}; }
  /* Línea de cierre de la tabla (la última) en color primario, como la cabecera */
  .desc-table tbody tr:last-child td { border-bottom: 1px solid {{ color1 }}; }

  /* ===================== IMPUESTOS / TOTAL ===================== */
  .l-tax { margin-top: 0; }
  .l-tax td { vertical-align: top; }
  .tax-table { width: auto; table-layout: auto; }
  .tax-table td { font-size: {{ font_size }}px; padding-right: 30px; color: {{ muted_color }}; line-height: 1.7; white-space: nowrap; }
  .tax-table .head td { font-weight: 800; color: {{ text_color }}; padding-bottom: 4px; }
  .total-plain-cell { text-align: right; vertical-align: top; padding-top: 4px; }
  .total-plain {
    font-weight: 800;
    font-size: {{ title_font_size }}px;
    color: {{ text_color }};
    white-space: nowrap;
  }

  /* ===================== OBSERVACIONES / RECIBOS / TEXTOS ===================== */
  .obs { margin-top: {{ (font_size * 1.5)|round }}px; font-size: {{ font_size }}px; color: {{ muted_color }}; line-height: 1.5; }
  .obs .t { font-weight: 800; color: {{ text_color }}; }
  .recibo-table { margin-top: {{ (font_size * 1.5)|round }}px; table-layout: auto; }
  .recibo-table th, .recibo-table td { white-space: nowrap; }
  .recibo-table th:nth-child(2), .recibo-table td:nth-child(2) { width: 100%; white-space: normal; word-break: break-word; }
  .recibo-table thead th { background: {{ color1 }}; color: {{ color2 }}; font-weight: 800; font-size: {{ font_size }}px; padding: 9px 14px; text-transform: uppercase; }
  .recibo-table tbody td { font-size: {{ font_size }}px; padding: 9px 14px; color: {{ muted_color }}; }
  .recibo-table tbody tr:nth-child(even) td { background: {{ color3 }}; }
  .recibo-table tbody tr:last-child td { border-bottom: 1px solid {{ color1 }}; }
  .end-text { margin-top: {{ (font_size * 1.3)|round }}px; font-size: {{ font_size - 1 }}px; color: {{ muted_color }}; }
  .thanks { margin-top: {{ (font_size * 1.5)|round }}px; text-align: center; }
  .thanks-title { font-size: {{ title_font_size }}px; font-weight: 800; color: {{ color1 }}; }
  .thanks-text { font-size: {{ font_size }}px; color: {{ muted_color }}; margin-top: 3px; }
</style>
</head>
<body>
{% include '_draft-warning.html.twig' %}
<div class="sheet">
  {# Sub-cabecera de continuación: aparece en el margen superior de las páginas 2+ (no en la 1ª) #}
  <div class="cont-info"><b>{{ doc.title }}{% if doc.code %} {{ doc.code }}{% endif %}</b>{% if doc.date %} · {{ doc.date }}{% endif %}{% if customer.name %} · {{ customer.name }}{% endif %}</div>

  <div class="top">

    {# ---------- CABECERA: bloque fiscal (documento + empresa) y logo ---------- #}
    {% set company_block %}
      <div class="company-fiscal-block">
        {% set slot = slots.DOCUMENT_TITLE_BEFORE %}{% include '_slot.html.twig' %}
        <div class="doc-title">{{ doc.title }}{% if doc.code %} {{ doc.code }}{% endif %}</div>
        {% set slot = slots.DOCUMENT_TITLE_AFTER %}{% include '_slot.html.twig' %}
        <div class="company-name">{{ company.name }}</div>
        <div class="company-info">
          {% if company.cifnif %}{{ 'cifnif'|trans }}: {{ company.cifnif }}<br/>{% endif %}
          {% for l in company.lines %}{{ l }}{% if not loop.last %}<br/>{% endif %}{% endfor %}
        </div>
        {% if company.contact %}<div class="company-contact">{{ company.contact }}</div>{% endif %}
        {% set slot = slots.PARTY_COMPANY_AFTER %}{% include '_slot.html.twig' %}
      </div>
    {% endset %}
    {% set logo_block %}{% if logo %}<img src="{{ logo }}" alt=""/>{% else %}<span class="logo-text">{{ company.name }}</span>{% endif %}{% endset %}

    {% if logo_position == 'center' %}
      {# Centrado sobre el ancho útil de la página, no dentro de su columna. #}
      <table class="l-header">
        <tr><td class="logo-cell" style="width:100%; text-align:center; vertical-align:top;">{{ logo_block }}</td></tr>
        <tr><td style="width:100%; vertical-align:top;">{{ company_block }}</td></tr>
      </table>
    {% elseif logo_position == 'left' %}
      <table class="l-header"><tr>
        <td class="logo-cell" style="width:38%; text-align:left; vertical-align:top;">{{ logo_block }}</td>
        <td style="width:62%; text-align:right; vertical-align:top;">{{ company_block }}</td>
      </tr></table>
    {% else %}
      <table class="l-header"><tr>
        <td style="width:62%; vertical-align:top;">{{ company_block }}</td>
        <td class="logo-cell" style="width:38%;">{{ logo_block }}</td>
      </tr></table>
    {% endif %}

    {# ---------- LÍNEA ROJA + BANDA CLIENTE/META + LÍNEA ROJA (solo documentos) ---------- #}
    {% if is_document %}
    <hr class="h-rule l-client-rule"/>
    {% set party_extra_slot = slots.PARTY_CUSTOMER_AFTER %}
    {% set party_extra_blocks = extension_blocks[party_extra_slot]|default([]) %}
    {% set has_party_extra = party_extra_blocks is not empty %}

    <table class="l-client"><tr>
      <td style="width:62%; padding-right:18px;">
        <table class="client-inner"><tr>
          <td style="width:{% if has_party_extra %}58%{% else %}100%{% endif %};">
            {% set slot = slots.PARTY_CUSTOMER_BEFORE %}{% include '_slot.html.twig' %}
            <div class="client-label">{{ customer.label }}{% if customer.code %} {{ customer.code }}{% endif %}</div>
            <div class="client-info">
              {% if customer.name %}{{ customer.name }}<br/>{% endif %}
              {% if customer.cifnif %}{{ 'cifnif'|trans }}: {{ customer.cifnif }}<br/>{% endif %}
              {% for l in customer.lines %}{{ l }}<br/>{% endfor %}
              {% include '_shipping-address.html.twig' %}
              {% set slot = slots.PARTY_SHIPPING_AFTER %}{% include '_slot.html.twig' %}
              {% if customer.agent %}{{ customer.agent }}<br/>{% endif %}
              {% if customer.phones %}{{ 'phone'|trans }}: {{ customer.phones }}<br/>{% endif %}
              {% if customer.email %}{{ customer.email }}{% endif %}
            </div>
          </td>
          {% if has_party_extra %}
          <td class="party-extra-inline" style="width:42%;">
            {% set slot = party_extra_slot %}{% include '_slot.html.twig' %}
          </td>
          {% endif %}
        </tr></table>
      </td>
      <td style="width:38%;">
        <table class="meta-table">
          {% set slot = slots.DOCUMENT_META_BEFORE %}{% include '_slot.html.twig' %}
          {% if doc.date %}<tr><td class="ml"><b>{{ 'date'|trans }}</b></td><td class="mr">{{ doc.date }}</td></tr>{% endif %}
          {% if doc.numero %}<tr><td class="ml"><b>{{ 'number'|trans }}</b></td><td class="mr">{{ doc.numero }}</td></tr>{% endif %}
          {% if doc.supplier_number %}<tr><td class="ml"><b>{{ 'numsupplier'|trans }}</b></td><td class="mr">{{ doc.supplier_number }}</td></tr>{% endif %}
          {% if doc.serie %}<tr><td class="ml"><b>{{ 'serie'|trans }}</b></td><td class="mr">{{ doc.serie }}</td></tr>{% endif %}
          {% if doc.numero2 %}<tr><td class="ml"><b>{{ 'number2'|trans }}</b></td><td class="mr">{{ doc.numero2 }}</td></tr>{% endif %}
          {% if doc.payment_date %}<tr><td class="ml"><b>{{ 'payment-date'|trans }}</b></td><td class="mr">{{ doc.payment_date }}</td></tr>{% endif %}
          {% for parent in doc.parent_docs %}<tr><td class="ml"><b>{{ 'document'|trans }}</b></td><td class="mr">{{ parent }}</td></tr>{% endfor %}
          {% set slot = slots.DOCUMENT_META_AFTER %}{% include '_slot.html.twig' %}
        </table>
      </td>
    </tr></table>

    <hr class="h-rule l-client-rule"/>
    {% endif %}

    {# ---------- LÍNEAS / TABLA GENÉRICA (el área reserva alto: los totales caen al fondo) ---------- #}
    {% set slot = slots.LINES_BEFORE %}{% include '_slot.html.twig' %}
    <div class="lines-area">
    <table class="desc-table">
      <thead>
        <tr>{% for c in columns %}<th style="text-align:{{ c.align }};width:{{ c.width }}%;{% if c.key == 'descripcion' or not is_document %}white-space:normal;overflow-wrap:anywhere;word-break:break-word;{% endif %}">{{ c.label }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in lines %}
        <tr>{% for cell in row %}{% set c = columns[loop.index0]|default({}) %}<td style="text-align:{{ cell.align }};width:{{ c.width|default(0) }}%;{% if c.key|default('') == 'descripcion' or not is_document %}white-space:normal;overflow-wrap:anywhere;word-break:break-word;{% endif %}">{% if cell.html|default(false) %}{{ cell.value|raw }}{% else %}{{ cell.value }}{% endif %}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% set slot = slots.LINES_AFTER %}{% include '_slot.html.twig' %}

  </div>

  <div class="bottom">

    {% include '_fiscal-landscape-columns-open.html.twig' %}

    {# ---------- IMPUESTOS + TOTAL TEXTO (posicionados por el anclaje inferior dinámico) ---------- #}
    {% if is_document and not hide_totals %}
    {% set slot = slots.TAXES_BEFORE %}{% include '_slot.html.twig' %}
    <table class="l-tax"><tr>
      <td style="width:58%;">
        <table class="tax-table">
          <tr class="head">
            <td>{{ 'tax'|trans }}</td>
            <td>{{ 'tax-base'|trans }}</td>
            <td>{{ 'percentage'|trans }}</td>
            <td>{{ 'amount'|trans }}</td>
          </tr>
          {% for t in taxes %}
          <tr><td>{{ t.label }}</td><td>{{ t.base }}</td><td>{{ t.pct }}</td><td>{{ t.cuota }}</td></tr>
          {% endfor %}
        </table>
        {% set slot = slots.TAXES_AFTER %}{% include '_slot.html.twig' %}
      </td>
      <td style="width:42%;" class="total-plain-cell">
        {% set slot = slots.TOTALS_BEFORE %}{% include '_slot.html.twig' %}
        <span class="total-plain">{{ 'total'|trans }}: {{ totals.total }}</span>
        {% set slot = slots.TOTALS_AFTER %}{% include '_slot.html.twig' %}
      </td>
    </tr></table>
    {% endif %}

    {% set slot = slots.OBSERVATIONS_BEFORE %}{% include '_slot.html.twig' %}
    {% if observations %}
    <div class="obs"><span class="t">{{ 'observations'|trans }}</span><br/>{{ observations|raw }}</div>
    {% endif %}
    {% set slot = slots.OBSERVATIONS_AFTER %}{% include '_slot.html.twig' %}

    {% set slot = slots.RECEIPTS_BEFORE %}{% include '_slot.html.twig' %}
    {% if receipts %}
    <table class="recibo-table">
      <thead><tr>
        <th style="text-align:center;">{{ 'receipt'|trans }}</th>
        {% if not hide_payment_methods %}<th style="text-align:center;">{{ 'payment-method'|trans }}</th>{% endif %}
        <th style="text-align:right;">{{ 'amount'|trans }}</th>
        <th style="text-align:right;">{{ 'expiration'|trans }}</th>
      </tr></thead>
      <tbody>
      {% for r in receipts %}
        <tr>
          <td style="text-align:center;">{{ r.numero }}</td>
          {% if not hide_payment_methods %}<td style="text-align:center;">{{ r.forma }}</td>{% endif %}
          <td style="text-align:right;">{{ r.importe }}</td>
          <td style="text-align:right;">{{ r.vencimiento }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    {% set slot = slots.RECEIPTS_AFTER %}{% include '_slot.html.twig' %}

    {% include '_fiscal-landscape-columns-close.html.twig' %}
    {% set slot = slots.FOOTER_BEFORE %}{% include '_slot.html.twig' %}
    {% if is_document and footer_text %}<div class="end-text">{{ footer_text|raw }}</div>{% endif %}
    {% include '_footer-image.html.twig' %}
    {% if is_document and (thanks_title or thanks_text) %}
    <div class="thanks">
      {% if thanks_title %}<div class="thanks-title">{{ thanks_title }}</div>{% endif %}
      {% if thanks_text %}<div class="thanks-text">{{ thanks_text }}</div>{% endif %}
    </div>
    {% endif %}
    {% set slot = slots.FOOTER_AFTER %}{% include '_slot.html.twig' %}

  </div>

</div>
</body>
</html>

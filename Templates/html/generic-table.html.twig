<!doctype html>
<html lang="{{ html_lang|default('es') }}">
<head>
  <meta charset="utf-8"/>
  <style>
  {{ font_faces|raw }}
  @page {
    size: {{ page_size }};
    margin: {{ page_margin }};
    {% if page_footer_content %}
    @{{ page_footer_box }} {
      content: {{ page_footer_content|raw }};
      font-size: {{ page_footer_size }}px;
      color: #6c757d;
    }
    {% endif %}
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: #212529;
    font-family: "{{ font_family }}", Arial, sans-serif;
    font-size: {{ font_size }}px;
    line-height: 1.16;
  }
  .doc-header {
    border-bottom: 1px solid #dee2e6;
    margin-bottom: 8px;
    padding-bottom: 6px;
  }
  .header-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .header-table td {
    padding: 0;
    vertical-align: middle;
  }
  .title {
    color: #212529;
    font-size: {{ title_font_size }}px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .meta {
    color: #6c757d;
    font-size: 8px;
    margin-top: 3px;
  }
  .company {
    color: #6c757d;
    font-size: 8px;
    line-height: 1.22;
    text-align: right;
  }
  .company-name {
    color: #212529;
    font-weight: 800;
    text-transform: uppercase;
  }
  .logo {
    max-height: 36px;
    max-width: {{ logo_size }}px;
    vertical-align: middle;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .data-table thead {
    display: table-header-group;
  }
  .data-table th {
    background: #f8f9fa;
    border-bottom: 2px solid #dee2e6;
    color: #212529;
    font-size: {{ font_size }}px;
    font-weight: 800;
    padding: 4px 5px;
    text-align: left;
    text-transform: uppercase;
  }
  .data-table td {
    border-bottom: 1px solid #dee2e6;
    padding: 4px 5px;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .right {
    text-align: right !important;
    white-space: nowrap;
  }
  .center {
    text-align: center !important;
  }
  .empty {
    color: #6c757d;
    padding-top: 12px;
    text-align: center;
  }
  </style>
</head>
<body>
  <header class="doc-header">
    <table class="header-table">
      <tr>
        {% if logo_position == 'left' %}
          <td style="width:20%; text-align:left;">{% if logo %}<img class="logo" src="{{ logo }}" alt=""/>{% endif %}</td>
          <td style="width:50%;"><div class="title">{{ title }}</div><div class="meta">{{ row_count }} registros</div></td>
          <td style="width:30%;" class="company">
        {% elseif logo_position == 'center' %}
          <td style="width:35%;"><div class="title">{{ title }}</div><div class="meta">{{ row_count }} registros</div></td>
          <td style="width:30%; text-align:center;">{% if logo %}<img class="logo" src="{{ logo }}" alt=""/>{% endif %}</td>
          <td style="width:35%;" class="company">
        {% else %}
          <td style="width:55%;"><div class="title">{{ title }}</div><div class="meta">{{ row_count }} registros</div></td>
          <td style="width:25%;" class="company">
        {% endif %}
            {% if company.name %}<div class="company-name">{{ company.name }}</div>{% endif %}
            {% if company.cifnif %}<div>{{ company.cifnif }}</div>{% endif %}
            {% for line in company.lines %}<div>{{ line }}</div>{% endfor %}
            {% if company.contact %}<div>{{ company.contact }}</div>{% endif %}
          </td>
        {% if logo_position == 'right' %}
          <td style="width:20%; text-align:right;">{% if logo %}<img class="logo" src="{{ logo }}" alt=""/>{% endif %}</td>
        {% endif %}
      </tr>
    </table>
  </header>

  <table class="data-table">
    <thead>
      <tr>
        {% for col in columns %}
          <th class="{{ col.align == 'right' ? 'right' : (col.align == 'center' ? 'center' : 'left') }}"{% if col.width is defined and col.width > 0 %} style="width:{{ col.width }}%;"{% endif %}>{{ col.label }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for line in lines %}
        <tr>
          {% for cell in line %}
            <td class="{{ cell.align == 'right' ? 'right' : (cell.align == 'center' ? 'center' : 'left') }}">{% if cell.html|default(false) %}{{ cell.value|raw }}{% else %}{{ cell.value }}{% endif %}</td>
          {% endfor %}
        </tr>
      {% else %}
        <tr><td class="empty" colspan="{{ columns|length }}">Sin datos</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% include '_footer-image.html.twig' %}
</body>
</html>

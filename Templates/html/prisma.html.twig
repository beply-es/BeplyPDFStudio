{# Slot contract: slots.FISCAL_FOOTER is rendered through _fiscal-landscape-columns-close.html.twig. #}
<!DOCTYPE html>
<html lang="{{ html_lang|default('es') }}">
<head>
<meta charset="UTF-8">
<style>
  /* Fuentes cargadas por fichero (file://) — el plugin no depende de fuentes instaladas. */
  {{ font_faces|raw }}
  /* ===================== REGLAS GENERALES (robustez SIEMPRE) ===================== */
  @page {
    size: {{ page_size }};
    /* En páginas 2+ el margen superior = marginTop configurado + banda para la sub-cabecera,
       de modo que el CONTENIDO siga respetando el marginTop configurado (la banda es extra). */
    margin: {{ page_mt + 13 }}mm {{ page_mr }}mm {{ page_mb }}mm {{ page_ml }}mm;
    {% if page_footer_content %}
    @{{ page_footer_box }} {
      content: {{ page_footer_content|raw }};
      font-family: '{{ font_family }}', Arial, sans-serif;
      font-size: {{ page_footer_size }}px;
      color: {{ faint_color }};
    }
    {% endif %}
    /* Sub-cabecera de continuación (solo páginas 2+, se suprime en :first), a todo el ancho */
    @top-left {
      content: element(contInfo);
      vertical-align: bottom;
      width: 100%;
    }
  }
  @page :first {
    /* La 1ª página NO lleva sub-cabecera: margen superior configurado tal cual */
    margin-top: {{ page_mt }}mm;
    @top-left { content: none; }
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: '{{ font_family }}', 'Helvetica Neue', Arial, sans-serif;
    color: {{ text_color }};
    font-size: {{ font_size }}px;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; }

  /* Maqueta con TABLAS (no flex): ancho 100% garantizado y render consistente */
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { vertical-align: top; overflow-wrap: break-word; word-break: break-word; }
  thead { display: table-header-group; }   /* la cabecera de tabla se repite al paginar */
  tr { break-inside: avoid; }               /* las filas no se parten entre páginas */
  .l-header-band, .l-doc-title, .l-client, .l-tax, .grand-total-box { break-inside: avoid; }

  /* Área de líneas: alto mínimo para que los totales caigan SIEMPRE al fondo de la página.
     El espacio sobrante lo "reservan" las líneas para crecer; si crecen, lo consumen (sin hueco). */
  .lines-area { min-height: {{ lines_fill }}px; }
  /* Sub-cabecera de continuación (running element en el margen superior, solo páginas 2+) */
  .cont-info { position: running(contInfo); display: block; width: 100%; font-size: {{ font_size - 1 }}px; color: {{ muted_color }}; border-bottom: 1.5px solid {{ color1 }}; padding-bottom: 5px; margin-bottom: {{ page_mt }}mm; }
  .cont-info b { color: {{ color1 }}; font-weight: 800; }
  /* Totales + extras fluyen tras las líneas; las piezas internas evitan partirse. */
  .bottom { {% if bottom_anchor_transform %}transform: translateY({{ bottom_anchor_gap }}px); transform-origin: top left;{% else %}padding-top: {{ bottom_anchor_gap }}px;{% endif %} }

  /* ===================== CABECERA BICOLOR (tabla 2 celdas) =====================
     Celda izquierda: fondo {{ color1 }} (naranja) — logo + nombre empresa ({{ color2 }} text)
     Celda derecha:  fondo {{ accent }} (navy)   — contacto empresa ({{ accent_on }} text)
  */
  /* A SANGRE: la cabecera bicolor llega a los bordes; el contenido se mete al margen */
  .l-header-band {
    margin: -{{ page_mt }}mm -{{ page_mr }}mm {{ (font_size * 1.2)|round }}px -{{ page_ml }}mm;
    width: calc(100% + {{ page_ml + page_mr }}mm);
    table-layout: fixed;
  }
  .hdr-orange {
    background: {{ color1 }};
    padding: 18px 20px 18px {{ page_ml }}mm;
    vertical-align: middle;
    width: 45%;
  }
  .hdr-navy {
    background: {{ accent }};
    padding: 18px {{ page_mr }}mm 18px 20px;
    vertical-align: top;
    width: 55%;
  }
  .hdr-logo { margin-bottom: 8px; }
  .hdr-logo img { width: {{ logo_size }}px; max-width: 100%; height: auto; }
  .hdr-logo-text { font-weight: 800; font-size: {{ font_size + 12 }}px; color: {{ color2 }}; letter-spacing: -0.5px; }
  .hdr-company-name {
    font-weight: 800;
    font-size: {{ font_size }}px;
    color: {{ color2 }};
    text-transform: uppercase;
    letter-spacing: .3px;
    line-height: 1.3;
  }
  /* Contact columns in navy: 3-column inner table (Web / Phone / Address) */
  /* Fijo, no automatico: en auto las 3 columnas nunca bajan de su ancho minimo y en papel
     estrecho (A5) la tabla se desbordaba fuera de la hoja. En fijo reparten el ancho
     disponible y el texto rompe por `word-break`. */
  .hdr-contact-table { table-layout: fixed; width: 100%; border-collapse: collapse; }
  .hdr-contact-table td {
    color: {{ accent_on }};
    font-size: {{ font_size - 1 }}px;
    line-height: 1.4;
    padding: 2px 10px 2px 0;
    vertical-align: top;
    white-space: normal;
    word-break: break-word;
  }
  .hdr-contact-label {
    font-weight: 800;
    font-size: {{ font_size - 1 }}px;
    color: {{ accent_on }};
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 2px;
  }

  /* ===================== TÍTULO DOC (FACTURA / INVOICE) ===================== */
  .l-doc-title {
    margin-bottom: {{ (font_size * 1.5)|round }}px;
    border-bottom: 3px solid {{ color1 }};
    padding-bottom: {{ (font_size * 0.5)|round }}px;
  }
  .doc-title-text {
    font-weight: 800;
    font-size: {{ title_font_size + 8 }}px;
    color: {{ text_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1;
  }

  /* ===================== CLIENTE · TOTAL DUE · METADATOS ===================== */
  .l-client { margin-bottom: {{ (font_size * 1.8)|round }}px; }
  .client-label { font-weight: 800; font-size: {{ font_size + 1 }}px; margin-bottom: 4px; color: {{ text_color }}; }
  .client-name { font-weight: 800; font-size: {{ font_size + 1 }}px; margin-bottom: 2px; color: {{ text_color }}; }
  .client-info { font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }
  /* Total Due: grande, derecha */
  .total-due-cell { text-align: right; vertical-align: top; }
  .total-due-label { font-size: {{ font_size }}px; color: {{ muted_color }}; margin-bottom: 4px; }
  .total-due-amount { font-weight: 800; font-size: {{ title_font_size + 2 }}px; color: {{ text_color }}; white-space: nowrap; }
  /* Metadatos: Invoice No / Date / Account No */
  .meta-table { margin-left: auto; width: auto; table-layout: auto; }
  .meta-table td { font-size: {{ font_size }}px; padding: 2px 0; }
  .meta-table .ml { text-align: left; white-space: nowrap; padding-right: 18px; font-weight: 800; }
  .meta-table .mr { text-align: right; white-space: nowrap; color: {{ muted_color }}; }
  .party-extra-box { vertical-align: top; }
  .party-extra-box .beply-slot-block { break-inside: avoid; }
  .party-extra-box .beply-slot-title { font-weight: 800; font-size: {{ font_size + 1 }}px; margin-bottom: 4px; color: {{ text_color }}; }
  .party-extra-box .beply-slot-body { font-size: {{ font_size }}px; line-height: 1.3; color: {{ muted_color }}; }

  /* ===================== TABLA DE LÍNEAS =====================
     Cabecera: fondo {{ color3 }} (gris claro), texto {{ color1 }} (naranja).
     auto-layout + cabecera en una sola línea (nowrap); la descripción ocupa el resto y ajusta. */
  .desc-table { table-layout: fixed; }
  .desc-table th, .desc-table td { white-space: nowrap; }
  .desc-table th:first-child, .desc-table td:first-child { white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
  .desc-table thead th {
    background: {{ color3 }};
    color: {{ color1 }};
    font-weight: 800;
    font-size: {{ font_size }}px;
    padding: 9px 12px;
    text-transform: uppercase;
    border-bottom: 2px solid {{ color1 }};
  }
  .desc-table tbody td { font-size: {{ font_size }}px; padding: 9px 12px; color: {{ muted_color }}; }
  .desc-table tbody td:first-child { color: {{ text_color }}; font-weight: 700; }
  .desc-table tbody td.sub-desc { font-weight: 400; font-size: {{ font_size - 1 }}px; color: {{ muted_color }}; }
  /* Bandeado de filas: línea sí, línea no (color terciario en las pares) */
  .desc-table tbody tr:nth-child(even) td { background: {{ color3 }}; }
  /* Línea de cierre de la tabla (la última) en color primario, como la cabecera */
  .desc-table tbody tr:last-child td { border-bottom: 1px solid {{ color1 }}; }

  /* ===================== SUBTOTALES / GRAND TOTAL (lado derecho) ===================== */
  /* Layout automatico: con table-layout:fixed la columna de totales quedaba clavada al 45%
     y, al ser el importe `nowrap`, se desbordaba por la derecha fuera del margen (se veia
     cortado). En automatico la columna toma el ancho que necesita y crece hacia la izquierda. */
  .l-tax { margin-top: {{ (font_size * 1.2)|round }}px; table-layout: auto; }
  .l-tax td { vertical-align: top; }
  /* Subtotals block: derecha, columna etiqueta + importe */
  .subtotals-wrap { text-align: right; }
  .subtotals-table { width: auto; table-layout: auto; margin-left: auto; border-collapse: collapse; }
  .subtotals-table td { font-size: {{ font_size }}px; padding: 4px 0 4px 20px; color: {{ muted_color }}; white-space: nowrap; }
  .subtotals-table .sub-label { text-align: left; }
  .subtotals-table .sub-value { text-align: right; }
  .subtotals-table .sub-discount { color: {{ color1 }}; }
  /* Grand total box */
  .grand-total-box {
    margin-top: 10px;
    background: {{ color1 }};
    color: {{ color2 }};
    font-weight: 800;
    font-size: {{ title_font_size - 2 }}px;
    padding: 12px 20px;
    text-align: right;
    white-space: nowrap;
  }

  /* ===================== MÉTODO DE PAGO ===================== */
  .payment-block { margin-top: {{ (font_size * 2.5)|round }}px; }
  .payment-heading {
    font-weight: 800;
    font-size: {{ font_size + 1 }}px;
    color: {{ color1 }};
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 6px;
    border-left: 4px solid {{ color1 }};
    padding-left: 8px;
  }
  .payment-info { font-size: {{ font_size }}px; color: {{ muted_color }}; line-height: 1.5; }

  /* ===================== RECIBOS ===================== */
  .recibo-table { margin-top: {{ (font_size * 2)|round }}px; table-layout: auto; }
  .recibo-table th, .recibo-table td { white-space: nowrap; }
  .recibo-table th:nth-child(2), .recibo-table td:nth-child(2) { width: 100%; white-space: normal; word-break: break-word; }
  .recibo-table thead th {
    background: {{ color3 }};
    color: {{ color1 }};
    font-weight: 800;
    font-size: {{ font_size }}px;
    padding: 9px 14px;
    text-transform: uppercase;
    border-bottom: 2px solid {{ color1 }};
  }
  .recibo-table tbody td { font-size: {{ font_size }}px; padding: 9px 14px; color: {{ muted_color }}; }
  .recibo-table tbody tr:nth-child(even) td { background: {{ color3 }}; }
  .recibo-table tbody tr:last-child td { border-bottom: 1px solid {{ color1 }}; }

  /* ===================== OBSERVACIONES / TEXTOS FINALES ===================== */
  .obs { margin-top: {{ (font_size * 2)|round }}px; font-size: {{ font_size }}px; color: {{ muted_color }}; line-height: 1.5; }
  .obs .t { font-weight: 800; color: {{ text_color }}; }
  .end-text { margin-top: {{ (font_size * 1.3)|round }}px; font-size: {{ font_size - 1 }}px; color: {{ muted_color }}; }

  /* ===================== GRACIAS + TÉRMINOS ===================== */
  .thanks-block { margin-top: {{ (font_size * 2.5)|round }}px; }
  .thanks-title { font-size: {{ title_font_size }}px; font-weight: 800; color: {{ color1 }}; margin-bottom: 6px; }
  .thanks-text { font-size: {{ font_size }}px; color: {{ muted_color }}; line-height: 1.5; }
  .terms-label { font-weight: 800; font-size: {{ font_size }}px; color: {{ text_color }}; margin-top: 8px; margin-bottom: 2px; }
</style>
</head>
<body>
{% include '_draft-warning.html.twig' %}
<div class="sheet">

  {# Sub-cabecera de continuación: aparece en el margen superior de las páginas 2+ (no en la 1ª) #}
  <div class="cont-info"><b>{{ doc.title }}{% if doc.code %} {{ doc.code }}{% endif %}</b>{% if doc.date %} · {{ doc.date }}{% endif %}{% if customer.name %} · {{ customer.name }}{% endif %}</div>

  <div class="top">

    {# ========== CABECERA BICOLOR: bloque de marca · bloque de contacto, según logo_position ========== #}
    {% set brand_block %}
          <div class="hdr-logo">
            {% if logo_white %}<img src="{{ logo_white }}" alt=""/>{% else %}<span class="hdr-logo-text">{{ company.name }}</span>{% endif %}
          </div>
          <div class="hdr-company-name">{{ company.name }}</div>
    {% endset %}
    {% set contact_block %}
          <table class="hdr-contact-table">
            <tr>
              {% if company.contact %}
              <td>
                <div class="hdr-contact-label">Web</div>
                <div>{{ company.contact }}</div>
              </td>
              {% endif %}
              {% if company.lines|length > 0 %}
              <td>
                <div class="hdr-contact-label">{{ 'phone'|trans }}</div>
                <div>{% for l in company.lines %}{% if loop.index <= 2 %}{{ l }}{% if not loop.last and loop.index < 2 %}<br/>{% endif %}{% endif %}{% endfor %}</div>
              </td>
              {% endif %}
              {% if company.cifnif or company.lines|length > 2 %}
              <td>
                <div class="hdr-contact-label">{{ 'address'|trans }}</div>
                <div>{% if company.cifnif %}{{ 'cifnif'|trans }}: {{ company.cifnif }}<br/>{% endif %}{% for l in company.lines %}{% if loop.index > 2 %}{{ l }}<br/>{% endif %}{% endfor %}</div>
              </td>
              {% endif %}
            </tr>
          </table>
    {% endset %}

    <table class="l-header-band">
      {% if logo_position == 'center' %}
      {# Centrado: la marca ocupa una banda propia a todo el ancho y el contacto queda debajo. #}
      <tr><td class="hdr-orange" colspan="2" style="width:100%; padding-right:{{ page_mr }}mm; text-align:center;">{{ brand_block }}</td></tr>
      <tr><td class="hdr-navy" colspan="2" style="width:100%; padding-left:{{ page_ml }}mm;">{{ contact_block }}</td></tr>
      {% elseif logo_position == 'right' %}
      {# Derecha: se refleja la banda bicolor, el bloque de marca pasa al lado derecho. #}
      <tr>
        <td class="hdr-navy" style="width:55%; padding-left:{{ page_ml }}mm; padding-right:20px;">{{ contact_block }}</td>
        <td class="hdr-orange" style="width:45%; padding-left:20px; padding-right:{{ page_mr }}mm; text-align:right;">{{ brand_block }}</td>
      </tr>
      {% else %}
      <tr>
        <td class="hdr-orange">{{ brand_block }}</td>
        <td class="hdr-navy">{{ contact_block }}</td>
      </tr>
      {% endif %}
    </table>

    {# ========== TÍTULO DEL DOCUMENTO (FACTURA) ========== #}
    <div class="l-doc-title">
      <span class="doc-title-text">{{ doc.title }}</span>
    </div>

    {# ========== CLIENTE + TOTAL DUE + METADATOS (solo documentos) ========== #}
    {% if is_document %}
    {% set party_extra_slot = slots.PARTY_CUSTOMER_AFTER %}
    {% set party_extra_blocks = extension_blocks[party_extra_slot]|default([]) %}
    {% set has_party_extra = party_extra_blocks is not empty %}
    <table class="l-client">
      <tr>
        {# --- Cliente izquierda --- #}
        <td style="width:{% if has_party_extra %}39%{% else %}55%{% endif %}; padding-right:20px;">
          <div class="client-label">{{ customer.label }}{% if customer.code %} {{ customer.code }}{% endif %}:</div>
          <div class="client-name">{{ customer.name }}</div>
          <div class="client-info">
            {% if customer.cifnif %}{{ 'cifnif'|trans }}: {{ customer.cifnif }}<br/>{% endif %}
            {% for l in customer.lines %}{{ l }}<br/>{% endfor %}
            {% include '_shipping-address.html.twig' %}
            {% if customer.phones %}{{ 'phone'|trans }}: {{ customer.phones }}<br/>{% endif %}
            {% if customer.email %}{{ customer.email }}<br/>{% endif %}
            {% if customer.agent %}{{ customer.agent }}{% endif %}
          </div>
        </td>
        {% if has_party_extra %}
        <td class="party-extra-box" style="width:28%; padding-right:20px;">
          {% set slot = party_extra_slot %}{% include '_slot.html.twig' %}
        </td>
        {% endif %}
        {# --- Total Due + metadatos derecha --- #}
        <td style="width:{% if has_party_extra %}33%{% else %}45%{% endif %};" class="total-due-cell">
          <div class="total-due-label">{{ 'total'|trans }} {{ 'due'|trans }}:</div>
          <div class="total-due-amount">{{ totals.total }}</div>
          <div style="margin-top:10px;">
            <table class="meta-table">
              {% if doc.code %}<tr><td class="ml">{{ 'invoice-number'|trans }}</td><td class="mr">{{ doc.code }}</td></tr>{% endif %}
              {% if doc.date %}<tr><td class="ml">{{ 'date'|trans }}</td><td class="mr">{{ doc.date }}</td></tr>{% endif %}
              {% if doc.numero %}<tr><td class="ml">{{ 'number'|trans }}</td><td class="mr">{{ doc.numero }}</td></tr>{% endif %}
              {% if doc.supplier_number %}<tr><td class="ml">{{ 'numsupplier'|trans }}</td><td class="mr">{{ doc.supplier_number }}</td></tr>{% endif %}
              {% if doc.serie %}<tr><td class="ml">{{ 'serie'|trans }}</td><td class="mr">{{ doc.serie }}</td></tr>{% endif %}
              {% if doc.numero2 %}<tr><td class="ml">{{ 'number2'|trans }}</td><td class="mr">{{ doc.numero2 }}</td></tr>{% endif %}
              {% if doc.payment_date %}<tr><td class="ml">{{ 'payment-date'|trans }}</td><td class="mr">{{ doc.payment_date }}</td></tr>{% endif %}
              {% for parent in doc.parent_docs %}<tr><td class="ml">{{ 'document'|trans }}</td><td class="mr">{{ parent }}</td></tr>{% endfor %}
            </table>
          </div>
        </td>
      </tr>
    </table>
    {% endif %}

    {# ========== TABLA DE LÍNEAS (el área reserva alto: los totales caen al fondo) ========== #}
    {% set slot = slots.LINES_BEFORE %}{% include '_slot.html.twig' %}
    <div class="lines-area">
    <table class="desc-table">
      <thead>
        <tr>{% for c in columns %}<th style="text-align:{{ c.align }};width:{{ c.width }}%;{% if c.key == 'descripcion' or not is_document %}white-space:normal;overflow-wrap:anywhere;word-break:break-word;{% endif %}">{{ c.label }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in lines %}
        <tr>{% for cell in row %}{% set c = columns[loop.index0]|default({}) %}<td style="text-align:{{ cell.align }};width:{{ c.width|default(0) }}%;{% if c.key|default('') == 'descripcion' or not is_document %}white-space:normal;overflow-wrap:anywhere;word-break:break-word;{% endif %}">{% if cell.html|default(false) %}{{ cell.value|raw }}{% else %}{{ cell.value }}{% endif %}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
    </div>

  </div>

  <div class="bottom">

    {% include '_fiscal-landscape-columns-open.html.twig' %}

    {# ========== SUBTOTALES + GRAND TOTAL (columna derecha, solo documentos) ========== #}
    {% if is_document %}
    <table class="l-tax">
      <tr>
        {# --- Vacío izquierda (elástico: cede ancho si los totales necesitan más) --- #}
        <td></td>
        {# --- Totales derecha --- #}
        <td style="width:1%;">
          <div class="subtotals-wrap">
            <table class="subtotals-table">
              {# Sub Total + impuestos por tramo #}
              <tr>
                <td class="sub-label" style="font-weight:800; color:{{ text_color }};">{{ 'subtotal'|trans }}</td>
                <td class="sub-value" style="font-weight:800; color:{{ text_color }};">{{ totals.net }}</td>
              </tr>
              {% for t in taxes %}
              <tr>
                <td class="sub-label">{{ t.label }}</td>
                <td class="sub-value">{{ t.cuota }}</td>
              </tr>
              {% endfor %}
            </table>
            <div class="grand-total-box">{{ 'beplypdf-grand-total'|trans|upper }}: {{ totals.total }}</div>
          </div>
        </td>
      </tr>
    </table>
    {% endif %}

    {# ========== RECIBOS / MÉTODO DE PAGO (columna FORMA condicional) ========== #}
    {% if receipts %}
    <div class="payment-block">
      <div class="payment-heading">&#9632; {{ hide_payment_methods ? 'receipt'|trans : 'payment-method'|trans }}</div>
      <table class="recibo-table">
        <thead><tr>
          <th style="text-align:center;">{{ 'receipt'|trans }}</th>
          {% if not hide_payment_methods %}<th style="text-align:center;">{{ 'payment-method'|trans }}</th>{% endif %}
          <th style="text-align:right;">{{ 'amount'|trans }}</th>
          <th style="text-align:right;">{{ 'expiration'|trans }}</th>
        </tr></thead>
        <tbody>
        {% for r in receipts %}
          <tr>
            <td style="text-align:center;">{{ r.numero }}</td>
            {% if not hide_payment_methods %}<td style="text-align:center;">{{ r.forma }}</td>{% endif %}
            <td style="text-align:right;">{{ r.importe }}</td>
            <td style="text-align:right;">{{ r.vencimiento }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {# ========== OBSERVACIONES ========== #}
    {% if observations %}
    <div class="obs"><span class="t">{{ 'observations'|trans }}:</span><br/>{{ observations|raw }}</div>
    {% endif %}

    {% include '_fiscal-landscape-columns-close.html.twig' %}
    {# ========== FOOTER TEXT ========== #}
    {% if is_document and footer_text %}<div class="end-text">{{ footer_text|raw }}</div>{% endif %}
    {% include '_footer-image.html.twig' %}

    {# ========== GRACIAS + TÉRMINOS ========== #}
    {% if is_document and (thanks_title or thanks_text) %}
    <div class="thanks-block">
      {% if thanks_title %}<div class="thanks-title">{{ thanks_title }}</div>{% endif %}
      {% if thanks_text %}
        <div class="terms-label">{{ 'terms-and-conditions'|trans }}:</div>
        <div class="thanks-text">{{ thanks_text }}</div>
      {% endif %}
    </div>
    {% endif %}

  </div>

</div>
</body>
</html>

 # Copyright (C) 2026 Beply Technologies S.L.
 #
 # Igual que el PanelController nativo (pestañas a la izquierda + contenido), pero
 # añadiendo una columna de vista previa a la derecha del todo.
 #}
{% extends "Master/PanelController.html.twig" %}

{% block body %}
    <style>
        @media (min-width: 992px) {
            .bps-preview-col { flex: 0 0 35%; max-width: 35%; }
        }
        .bps-preview-mock {
            aspect-ratio: 210 / 297;
            border: 1px solid #dee2e6;
            border-radius: .25rem;
            background: #fff;
            overflow: hidden;
        }
        .bps-preview-mock svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        .bps-panel-body {
            padding-top: .75rem;
        }
        .bps-panel-body .nav-pills .nav-link,
        .bps-panel-body .nav-pills .nav-link.active {
            font-weight: 400 !important;
        }
        .bps-panel-body .nav-pills .nav-link.active {
            color: #fff !important;
        }
    </style>
    <div class="container-fluid bps-panel-body">
        {% if fsc.formatScoped %}
            <div class="alert alert-info small mb-2">
                <i class="fa-solid fa-circle-info me-1"></i>
                {{ trans('beplypdf-format-style-scope-help') }}
                {% if fsc.formatScopedName %}
                    <strong>{{ fsc.formatScopedName }}</strong>
                {% endif %}
            </div>
        {% endif %}
        <div class="row g-2">
            {# -- Columna 1: pestañas (nativo) -- #}
            {% if fsc.views | length > 1 %}
                <div class="col-12 col-lg-auto mt-lg-2">
                    <div class="nav nav-pills flex-row flex-lg-column overflow-x-auto" id="mainTabs" role="tablist" style="white-space: nowrap;">
                        {% for viewName, view in fsc.views %}
                            {% set active = (viewName == fsc.active) ? ' active' : '' %}
                            {% set disable = view.settings.active ? '' : ' disabled' %}
                            <a class="nav-link{{ active }}{{ disable }} text-nowrap" id="{{ viewName }}-tab" data-bs-toggle="pill"
                               href="#{{ viewName }}" role="tab" aria-controls="{{ viewName }}" aria-expanded="true">
                                <i class="{{ view.icon }} fa-fw me-1 d-none d-lg-inline-block" aria-hidden="true"></i><span class="d-inline d-lg-inline">{{ view.title }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# -- Columna 2: contenido de la pestaña activa (nativo) -- #}
            <div class="col-12 col-lg">
                <div class="tab-content" id="mainTabsContent">
                    {% for viewName, view in fsc.views %}
                        {% set active = (viewName == fsc.active) ? ' show active' : '' %}
                        <div class="tab-pane fade{{ active }}" id="{{ viewName }}" role="tabpanel" aria-labelledby="{{ viewName }}-tab">
                            {% do fsc.setCurrentView(viewName) %}
                            {{ include(view.template) }}
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# -- Columna 3: vista previa en PDF (a la derecha del todo, ~35% del ancho) -- #}
            <div class="col-12 mt-lg-2 bps-preview-col">
                <div class="position-lg-sticky" style="top:1rem;">
                    <div class="card shadow-sm">
                        <div class="card-body p-2">
                            <div class="d-flex align-items-center mb-2 px-1">
                                <span class="text-muted text-uppercase small">
                                    <i class="fa-solid fa-file-pdf me-1"></i> {{ trans('beplypdf-preview') }}
                                </span>
                                {% if fsc.previewUrl %}
                                    <a href="{{ asset(fsc.previewUrl) }}" target="_blank" class="ms-auto small text-decoration-none">
                                        <i class="fa-solid fa-up-right-from-square"></i>
                                    </a>
                                {% endif %}
                            </div>
                            {% if fsc.previewUrl %}
                                <iframe src="{{ asset(fsc.previewUrl) }}#toolbar=0&navpanes=0&view=FitH"
                                        class="w-100 rounded border" style="height:78vh;" title="preview"
                                        loading="lazy"></iframe>
                            {% elseif fsc.previewDesign %}
                                <img src="{{ asset('Dinamic/Assets/Images/beplypdf_' ~ fsc.previewDesign ~ '.webp') }}"
                                     alt="preview" class="img-fluid rounded border" style="width:100%;"/>
                            {% else %}
                                <div class="bps-preview-mock">
                                    <svg viewBox="0 0 210 297" preserveAspectRatio="xMidYMid meet" role="img" aria-label="preview">
                                        <rect width="210" height="297" fill="#fff"/>
                                        <rect x="18" y="18" width="48" height="22" fill="#111"/>
                                        <rect x="128" y="20" width="54" height="5" fill="#9aa0a6"/>
                                        <rect x="142" y="30" width="40" height="4" fill="#e9ecef"/>
                                        <rect x="18" y="72" width="174" height="10" fill="#111"/>
                                        {% for i in 0..7 %}
                                            <rect x="18" y="{{ 90 + i * 13 }}" width="174" height="8" fill="{{ i is even ? '#e9ecef' : '#f6f7f8' }}"/>
                                        {% endfor %}
                                        <rect x="118" y="218" width="64" height="10" fill="#9aa0a6"/>
                                        <rect x="118" y="236" width="64" height="20" fill="none" stroke="#111" stroke-width="1.6"/>
                                        <line x1="18" y1="276" x2="192" y2="276" stroke="#9aa0a6" stroke-width="1"/>
                                    </svg>
                                </div>
                            {% endif %}
                            <p class="text-muted small mt-2 mb-0 px-1">Se actualiza al guardar los cambios.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

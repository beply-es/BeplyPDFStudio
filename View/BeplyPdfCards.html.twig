 # Copyright (C) 2026 Beply Technologies S.L.
 #
 # Reutiliza la estructura y las macros nativas de la ListView del core; solo el
 # contenido del listado (la tabla) se sustituye por una rejilla de cards.
 #}
{% import "Master/ListView.html.twig" as lv %}
{% set currentView = fsc.getCurrentView() %}
{% set formName = 'form' ~ currentView.getViewName() %}

<script>
    var listViewDeleteCancel = "{{ trans('cancel') }}";
    var listViewDeleteConfirm = "{{ trans('confirm') }}";
    var listViewDeleteMessage = "{{ trans('are-you-sure') }}";
    var listViewDeleteTitle = "{{ trans('confirm-delete') }}";
</script>

<form id="{{ formName }}" method="post" onsubmit="animateSpinner('add')">
    {{ formToken() }}
    <input type="hidden" name="action"/>
    <input type="hidden" name="activetab" value="{{ currentView.getViewName() }}"/>
    <input type="hidden" name="loadfilter" value="{{ currentView.pageFilterKey }}"/>
    <input type="hidden" name="offset" value="{{ currentView.offset }}"/>
    <input type="hidden" name="order" value="{{ currentView.orderKey }}"/>
    <div>
        <div class="container-fluid">
            <div class="row">
                {# -- Botones (nativos) -- #}
                <div class="col-md-auto mb-2">
                    {% if currentView.settings.btnNew %}
                        <a href="{{ asset(currentView.btnNewUrl()) }}" class="btn btn-success" title="{{ trans('new') }}">
                            <i class="fa-solid fa-plus fa-fw"></i>
                            <span class="d-none d-xl-inline-block">{{ trans('new') }}</span>
                        </a>
                    {% endif %}
                    {% if currentView.settings.btnDelete and currentView.count > 0 %}
                        <button type="button" class="btn btn-danger" onclick="listViewDelete('{{ currentView.getViewName() }}');" title="{{ trans('delete') }}">
                            <i class="fa-solid fa-trash-alt fa-fw"></i>
                        </button>
                    {% endif %}
                    {% if currentView.settings.btnPrint and currentView.count > 0 %}
                        <div class="btn-group">{{ lv.printButton(fsc, currentView) }}</div>
                    {% endif %}
                    {{ currentView.getRow('actions').render(true, currentView.getViewName()) | raw }}
                    {{ currentView.getRow('statistics').render(fsc) | raw }}
                </div>
                {# -- Buscador (nativo) -- #}
                <div class="col-sm mb-2">{{ lv.searchControl(currentView) }}</div>
                {# -- Filtros / orden / colores (nativos) -- #}
                <div class="col-sm-auto text-end mb-2">
                    {{ lv.filterButton(currentView, fsc) }}
                    {{ lv.sortButton(currentView) }}
                    {{ lv.colorsButton(currentView) }}
                </div>
            </div>
            {# -- Filtros (nativos) -- #}
            {% set divFiltersStyle = currentView.showFilters ? '' : 'display: none;' %}
            <div id="form{{ currentView.getViewName() }}Filters" class="row g-2 align-items-center border-bottom mb-3" style="{{ divFiltersStyle }}">
                {% for filterName, filter in currentView.filters %}{{ filter.render() | raw }}{% endfor %}
            </div>
        </div>

        {# -- Paginación superior (nativa) -- #}
        {% set pages = currentView.getPagination() %}
        {% if pages | length > 4 %}
            <div class="text-center pb-2"><div class="btn-group">
                {% for page in pages %}
                    {% set btnClass = page.active ? 'btn btn-outline-dark active' : 'btn btn-outline-dark' %}
                    <button type="button" class="{{ btnClass }}" onclick="listViewSetOffset('{{ currentView.getViewName() }}', '{{ page.offset }}');">{{ page.num }}</button>
                {% endfor %}
            </div></div>
        {% endif %}

        {# -- Selector de empresa (solo si hay más de una) -- #}
        {% if fsc.multiEmpresa %}
            <div class="container-fluid">
                <div class="row align-items-center mb-3">
                    <div class="col-auto">
                        <label class="col-form-label fw-bold mb-0">
                            <i class="fa-solid fa-building me-1"></i> {{ trans('company') }}
                        </label>
                    </div>
                    <div class="col-auto">
                        <select class="form-select" onchange="window.location='AdminBeplyPdf?activetab={{ currentView.getViewName() }}&amp;empresa='+this.value;">
                            {% for e in fsc.empresas %}
                                <option value="{{ e.idempresa }}"{{ e.idempresa == fsc.selectedEmpresa ? ' selected' : '' }}>{{ e.nombrecorto ?: e.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col text-muted small d-none d-md-block">
                        Cada empresa tiene su propio diseño, logo y campos visibles.
                    </div>
                </div>
            </div>
        {% endif %}

        {# -- CONTENIDO DEL LISTADO (custom): rejilla con los diseños; la activa, marcada -- #}
        {# Rejilla fluida: de 1 a 6 tarjetas por fila según el ancho (mín. 190px, máx. 1/6 del ancho). #}
        <style>
            .bps-gallery {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(max(190px, calc((100% - 5rem) / 6)), 1fr));
                gap: 1rem;
            }
            /* Miniatura recortada: muestra la parte de ARRIBA del documento (cabecera + líneas)
               a una proporción compacta, sin el gran espacio en blanco inferior de la página A4. */
            /* Miniatura A4: misma proporción y tamaño para TODAS, página completa sin recortar. */
            .bps-thumb {
                aspect-ratio: 210 / 297;
                overflow: hidden;
                border: 1px solid #e3e6ea;
                border-radius: .3rem;
                background: #fff;
            }
            .bps-thumb img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                display: block;
            }
        </style>
        <div class="container-fluid">
            <div class="bps-gallery">
                {% for d in fsc.designs %}
                    {% set isActive = d.key == fsc.activeDesign %}
                    {% set imgsrc = '' %}
                    <div class="bps-cell">
                        <div class="card h-100 {{ isActive ? 'border-success border-2' : '' }}">
                            <div class="card-body p-3 d-flex flex-column">
                                {% if isActive and fsc.activePreviewUrl %}
                                    {% set imgsrc = asset(fsc.activePreviewUrl) %}
                                {% elseif fsc.designPreviews[d.key] is defined and fsc.designPreviews[d.key] %}
                                    {% set imgsrc = asset(fsc.designPreviews[d.key]) %}
                                {% else %}
                                    {% set imgsrc = asset('Dinamic/Assets/Images/beplypdf_' ~ d.key ~ '.webp') ~ '?v=1.19' %}
                                {% endif %}
                                <div class="bps-thumb">
                                    <img src="{{ imgsrc }}" alt="{{ d.name }}" loading="lazy"/>
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <span class="fw-bold">{{ d.name }}</span>
                                    {% if isActive and fsc.activeInherited %}
                                        <span class="badge bg-secondary ms-auto">Heredado</span>
                                    {% endif %}
                                </div>
                                <div class="small text-muted mb-2">{{ d.layout }}</div>
                                <div class="mt-auto">
                                {% if isActive and fsc.activeStyleId %}
                                    <a href="EditBeplyPdfStyle?code={{ fsc.activeStyleId }}" class="btn btn-sm btn-success w-100">
                                        <i class="fa-solid fa-sliders"></i> {{ trans('configure') }}
                                    </a>
                                {% else %}
                                    <form method="post">
                                        {{ formToken() }}
                                        <input type="hidden" name="action" value="use-design"/>
                                        <input type="hidden" name="activetab" value="{{ currentView.getViewName() }}"/>
                                        <input type="hidden" name="diseno" value="{{ d.key }}"/>
                                        {% if fsc.selectedEmpresa is not null %}
                                            <input type="hidden" name="empresa" value="{{ fsc.selectedEmpresa }}"/>
                                        {% endif %}
                                        <button type="submit" class="btn btn-sm {{ isActive ? 'btn-success' : 'btn-outline-primary' }} w-100">
                                            {{ isActive ? 'Personalizar para esta empresa' : 'Usar esta plantilla' }}
                                        </button>
                                    </form>
                                {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# -- Paginación inferior (nativa) -- #}
        {% if pages | length > 0 %}
            <div class="pt-3 text-center"><div class="btn-group">
                {% for page in pages %}
                    {% set btnClass = page.active ? 'btn btn-outline-dark active' : 'btn btn-outline-dark' %}
                    <button type="button" class="{{ btnClass }}" onclick="listViewSetOffset('{{ currentView.getViewName() }}', '{{ page.offset }}');">{{ page.num }}</button>
                {% endfor %}
            </div></div>
        {% endif %}
    </div>

    {# -- Modal guardar filtro (nativo) -- #}
    {% if currentView.showFilters %}{{ lv.filterSaveModal(currentView) }}{% endif %}
</form>
